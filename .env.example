# Copy to .env and adjust. Loaded automatically by `npm start`.
PORT=3000
# Where the SQLite database and uploaded banners are stored (back this folder up!)
DATA_DIR=./data
# Initial administrator (only used the first time, when no admin exists yet).
# If ADMIN_PASSWORD is empty, a random one is generated, printed once and saved to data/initial-admin-credentials.txt
ADMIN_EMAIL=admin@sevitrack.com
ADMIN_PASSWORD=
# Set when running behind a reverse proxy / HTTPS terminator so secure cookies and client IPs work
# TRUST_PROXY=true
# NODE_ENV=production
